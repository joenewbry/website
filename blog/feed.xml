---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>Software, Surfing, and Startups — Joe Newbry</title>
  <link>{{ '/blog/' | absolute_url | xml_escape }}</link>
  <description>New writing by Joe Newbry.</description>
  <language>en-us</language>
  <atom:link href="{{ '/blog/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>
  {% for post in site.posts limit:30 %}
  <item>
    <title>{{ post.title | xml_escape }}</title>
    <link>{{ post.url | absolute_url | xml_escape }}</link>
    <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
    <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    <description>{{ post.excerpt | xml_escape }}</description>
  </item>
  {% endfor %}
</channel>
</rss>
